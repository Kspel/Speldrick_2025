        "!pip install --upgrade prose\n",
        "!pip install astropy\n",
        "import glob\n",
        "import os\n",
        "\n",
        "# Mount Google Drive\n",
        "from google.colab import drive\n",
        "drive.mount('/content/drive')\n",
        "\n",
        "# Import necessary libraries\n",
        "from prose import FitsManager, FITSImage, simulations, Sequence, blocks\n",
        "import os\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from prose.blocks.visualization import Video\n",
        "from prose.core.source import ExtendedSource\n",
        "from astropy.io import fits\n",
        "\n",
        "# Set folder path for images (adjust depth if needed)\n",
        "folder = \"/content/drive/MyDrive/Comet/Comet L3 Atlas Jan.6.2022\"\n",
        "\n",
        "# Attempt to find and list all FITS files in the folder and subfolders\n",
        "fits_files = []\n",
        "for filename in os.listdir(folder):\n",
        "    if filename.endswith(('.fits', '.fit')):\n",
        "        filepath = os.path.join(folder, filename)  # Create full path, This is what fixed everything\n",
        "        fits_files.append(filepath)\n",
        "\n",
        "\n",
        "# Print statements for debugging\n",
        "print(fits_files)\n",
        "print(len(fits_files))\n",
        "\n",
        "# Create Video block\n",
        "video = Video(destination=\"video2.mp4\", fps=10, width=500)\n",
        "\n",
        "# Process images and generate video\n",
        "sequence = Sequence([video])\n",
        "sequence.run(fits_files, show_progress=True) # Use fits_files here"
      ],
